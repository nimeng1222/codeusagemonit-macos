<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="CodeUsageMonit.Desktop.MainWindow"
        Title="codeusagemonit" Width="420" Height="790" MinWidth="360" MinHeight="460"
        WindowDecorations="None" TransparencyLevelHint="AcrylicBlur"
        Background="Transparent" TransparencyBackgroundFallback="#00000000"
        ShowInTaskbar="False" CanResize="True"
        FontFamily=".AppleSystemUIFont, Helvetica Neue, PingFang SC"
        FontSize="12" Foreground="#F2F3F5"
        ExtendClientAreaToDecorationsHint="True">
  <!-- Panel.xaml 的窗口树（Panel.xaml:229-285）：无边框、圆角 Surface、背景图层、
       CompactRoot（small/medium/large 渲染处）与 ScaleRoot（完整面板四行）。
       差异：Segoe Fluent Icons 字形换成内嵌 Geometry 资源（窗口资源）；WindowDecorations=None
       （Avalonia 12 新名，旧 SystemDecorations 已过时）+ 手动 7px 调整边（WindowFrame）
       替代 WindowChrome；标题区左侧是自绘 macOS 红绿灯；Ctrl+滚轮缩放经 LayoutTransformControl。 -->
  <Window.Resources>
    <!-- 内嵌图标（替代 Segoe Fluent Icons 字形）：E72C 刷新 / E73F 尺寸 / E718 图钉 / E713 设置 / E8BB 关闭。 -->
    <StreamGeometry x:Key="IconRefresh">M13.408,3.2 A5.6,5.6 0 1 0 15.6,7.5 L13.9,7.5 A3.9,3.9 0 1 1 12.266,4.334 L10.5,6.1 L15.5,6.1 L15.5,1.1 L13.9,2.7 A5.59,5.59 0 0 0 13.408,3.2 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSize">M2,2 L7,2 L7,3.5 L3.5,3.5 L3.5,7 L2,7 Z M9,2 L14,2 L14,7 L12.5,7 L12.5,3.5 L9,3.5 Z M2,9 L3.5,9 L3.5,12.5 L7,12.5 L7,14 L2,14 Z M12.5,9 L14,9 L14,14 L9,14 L9,12.5 L12.5,12.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconPin">M9.5,1.5 L14.5,6.5 L12.4,7.2 L9.9,7.2 L6.9,10.2 L7.6,14 L6.5,14 L4.9,9.1 L1.7,12.3 L1,11.6 L4.2,8.4 L1.5,3 L2.8,2.4 L7.8,4.6 L9.2,1.5 Z</StreamGeometry>
    <StreamGeometry x:Key="IconSettings">M8,5.5 A2.5,2.5 0 1 0 8,10.5 A2.5,2.5 0 0 0 8,5.5 Z M8,7 A1,1 0 1 1 8,9 A1,1 0 0 1 8,7 Z M6.9,1 L9.1,1 L9.5,2.8 A5.3,5.3 0 0 1 11.1,3.7 L12.9,3 L14,5 L12.5,6.1 A5,5 0 0 1 12.5,8.9 L14,10 L12.9,12 L11.1,11.3 A5.3,5.3 0 0 1 9.5,12.2 L9.1,14 L6.9,14 L6.5,12.2 A5.3,5.3 0 0 1 4.9,11.3 L3.1,12 L2,10 L3.5,8.9 A5,5 0 0 1 3.5,6.1 L2,5 L3.1,3 L4.9,3.7 A5.3,5.3 0 0 1 6.5,2.8 Z</StreamGeometry>
    <StreamGeometry x:Key="IconClose">M3.4,2.34 L8,6.94 L12.6,2.34 L13.66,3.4 L9.06,8 L13.66,12.6 L12.6,13.66 L8,9.06 L3.4,13.66 L2.34,12.6 L6.94,8 L2.34,3.4 Z</StreamGeometry>
    <!-- 红绿灯字形（13px 圆点内居中，Path 坐标即 Panel 内绝对位置；描边圆帽近似 macOS 细字形）。 -->
    <StreamGeometry x:Key="TrafficCloseGlyph">M4.5,4.5 L8.5,8.5 M8.5,4.5 L4.5,8.5</StreamGeometry>
    <StreamGeometry x:Key="TrafficMinimizeGlyph">M3.75,6.5 L9.25,6.5</StreamGeometry>
    <StreamGeometry x:Key="TrafficZoomGlyph">M6.5,3.75 L6.5,9.25 M3.75,6.5 L9.25,6.5</StreamGeometry>
  </Window.Resources>

  <Panel x:Name="Root">
    <Border x:Name="Surface" Background="#A815171B" BorderBrush="#26FFFFFF" BorderThickness="1" CornerRadius="8">
      <Grid>
        <!-- Optional background picture and its dimming layer (see Appearance.cs). -->
        <Border x:Name="BackdropImage" CornerRadius="7" IsVisible="False" />
        <Border x:Name="BackdropScrim" CornerRadius="7" IsVisible="False" />
        <!-- Small / medium / large display sizes render here; ScaleRoot is the full panel. -->
        <Border x:Name="CompactRoot" IsVisible="False" Background="Transparent" />
        <LayoutTransformControl x:Name="ScaleRootHost">
          <Grid x:Name="ScaleRoot">
            <Grid.RowDefinitions>
              <RowDefinition Height="46" />
              <RowDefinition Height="Auto" />
              <RowDefinition Height="*" />
              <RowDefinition Height="30" />
            </Grid.RowDefinitions>

            <!-- Header: drag to move (BeginMoveDrag), right-click for display sizes. -->
            <Grid x:Name="TitleArea" Background="Transparent" Margin="14,0,8,0" Grid.Row="0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,9,0">
                <!-- 自绘 macOS 红绿灯：关闭 = 收起到托盘（驻留），黄色 = 最小化，绿色 = 循环显示尺寸。
                     默认纯色圆点，悬停显示字形（App.axaml 的 Button.traffic 样式）。 -->
                <Button x:Name="TrafficClose" Classes="traffic" ToolTip.Tip="收起到托盘" AutomationProperties.Name="收起面板">
                  <Panel Width="13" Height="13">
                    <Ellipse Width="13" Height="13" Fill="#FF5F57" Stroke="#E0443E" StrokeThickness="0.75" />
                    <Path Classes="traffic-glyph" Data="{StaticResource TrafficCloseGlyph}" Stroke="#99000000" StrokeThickness="1.4" StrokeLineCap="Round" />
                  </Panel>
                </Button>
                <Button x:Name="TrafficMinimize" Classes="traffic" Margin="7,0,0,0" ToolTip.Tip="最小化" AutomationProperties.Name="最小化">
                  <Panel Width="13" Height="13">
                    <Ellipse Width="13" Height="13" Fill="#FEBC2E" Stroke="#DEA123" StrokeThickness="0.75" />
                    <Path Classes="traffic-glyph" Data="{StaticResource TrafficMinimizeGlyph}" Stroke="#99000000" StrokeThickness="1.4" StrokeLineCap="Round" />
                  </Panel>
                </Button>
                <Button x:Name="TrafficZoom" Classes="traffic" Margin="7,0,0,0" ToolTip.Tip="显示尺寸（小 / 中 / 大 / 完整 / 窄条）" AutomationProperties.Name="切换显示尺寸">
                  <Panel Width="13" Height="13">
                    <Ellipse Width="13" Height="13" Fill="#28C840" Stroke="#1AAB29" StrokeThickness="0.75" />
                    <Path Classes="traffic-glyph" Data="{StaticResource TrafficZoomGlyph}" Stroke="#99000000" StrokeThickness="1.4" StrokeLineCap="Round" />
                  </Panel>
                </Button>
              </StackPanel>
              <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" IsHitTestVisible="False">
                <Grid x:Name="Logo" Width="13" Height="14" Margin="0,0,9,0" VerticalAlignment="Center">
                  <Border Width="3" Height="7" Background="#6DE0D6" CornerRadius="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" />
                  <Border Width="3" Height="14" Background="#96D9EE" CornerRadius="1" HorizontalAlignment="Center" VerticalAlignment="Bottom" />
                  <Border Width="3" Height="10" Background="#D6C1F9" CornerRadius="1" HorizontalAlignment="Right" VerticalAlignment="Bottom" />
                </Grid>
                <TextBlock x:Name="TitleText" Text="codeusagemonit" FontSize="12.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                <Border x:Name="DemoBadge" IsVisible="False" Margin="8,0,0,0" Padding="6,1,6,2" CornerRadius="4" Background="#1A5CC8E0" VerticalAlignment="Center">
                  <TextBlock Text="演示" FontSize="10" Foreground="#5CC8E0" />
                </Border>
              </StackPanel>
              <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="RefreshButton" Classes="icon-button" ToolTip.Tip="刷新（F5）" AutomationProperties.Name="刷新额度">
                  <Path x:Name="RefreshGlyph" Data="{StaticResource IconRefresh}" Width="13" Height="13" Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" RenderTransformOrigin="0.5,0.5" />
                </Button>
                <Button x:Name="SizeButton" Classes="icon-button" ToolTip.Tip="显示尺寸（小 / 中 / 大 / 完整 / 窄条）" AutomationProperties.Name="显示尺寸">
                  <Path Data="{StaticResource IconSize}" Width="13" Height="13" Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" />
                </Button>
                <Button x:Name="PinButton" Classes="icon-button" AutomationProperties.Name="固定面板">
                  <Path Data="{StaticResource IconPin}" Width="13" Height="13" Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" />
                </Button>
                <Button x:Name="SettingsButton" Classes="icon-button" ToolTip.Tip="设置" AutomationProperties.Name="设置">
                  <Path Data="{StaticResource IconSettings}" Width="13" Height="13" Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" />
                </Button>
                <Button x:Name="HideButton" Classes="icon-button" ToolTip.Tip="收起到托盘（Esc）" AutomationProperties.Name="收起面板">
                  <Path Data="{StaticResource IconClose}" Width="11" Height="11" Fill="{Binding $parent[Button].Foreground}" Stretch="Uniform" />
                </Button>
              </StackPanel>
            </Grid>

            <Grid x:Name="TabHost" Grid.Row="1" Margin="10,0,10,0">
              <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
              </Grid.RowDefinitions>
              <!-- 平台页签：WrapPanel 按内容自适应宽度（UniformGrid 等分会挤压长名称；fix6 #6）。 -->
              <WrapPanel x:Name="Tabs" HorizontalAlignment="Center" />
              <Border Grid.Row="1" Height="1" Background="#14FFFFFF" Margin="4,8,4,0" />
            </Grid>

            <Grid Grid.Row="2">
              <!-- Background="Transparent"：参与命中测试（滚轮/拖动滚动在卡片缝隙与视口
                   空白处同样生效），透明不着色、Surface 正常透出；实际命中面是模板里
                   PART_ContentPresenter 的 TemplateBinding（见 App.axaml ScrollViewer 模板）。 -->
              <ScrollViewer x:Name="BodyScroll" Background="Transparent" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Margin="0,0,4,0" Padding="14,12,8,6">
                <StackPanel x:Name="Body" />
              </ScrollViewer>
            </Grid>

            <Grid Grid.Row="3" Margin="16,0,14,0">
              <Grid.ColumnDefinitions>
                <ColumnDefinition />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <Border Grid.ColumnSpan="2" Height="1" Background="#10FFFFFF" VerticalAlignment="Top" Margin="-2,0" />
              <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                <Ellipse x:Name="StatusDot" Width="6" Height="6" Fill="#7AD3A8" Margin="0,0,7,0" VerticalAlignment="Center" />
                <TextBlock x:Name="StatusText" FontSize="10.5" Foreground="#8A909A" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <TextBlock x:Name="ScaleText" Grid.Column="1" FontSize="10.5" Foreground="#6F757F" VerticalAlignment="Center" Margin="8,0,0,0" />
            </Grid>
          </Grid>
        </LayoutTransformControl>
      </Grid>
    </Border>
    <!-- 7px resize edges（WindowFrame 填充）；悬浮层必须盖在 Surface 之上。 -->
    <Panel x:Name="ResizeLayer" />
  </Panel>
</Window>
